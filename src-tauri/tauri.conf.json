{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WOD Timer",
  "version": "0.1.0",
  "identifier": "com.gaoryan.wod-timer",
  "build": {
    "beforeDevCommand": "npm run app:prepare",
    "beforeBuildCommand": "npm run app:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WOD Timer",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
